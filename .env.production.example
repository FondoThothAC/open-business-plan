# ─────────────────────────────────────────────────────────
#  OBP — Variables de Entorno para Producción (VPS)
#  Copiar este archivo como .env.local en el VPS y rellenar
#  con los valores reales de las API keys.
# ─────────────────────────────────────────────────────────

# ─── Configuración del servidor ───
NODE_ENV=production
PORT=3001
HOST=127.0.0.1

# ─── Base path para Vite (no cambiar) ───
VITE_BASE_PATH=/obp/

# ─── Proveedores de IA (al menos uno requerido) ───
# OpenRouter — Recomendado como proveedor principal
VITE_OPENROUTER_KEY=

# Groq — Inferencia ultrarrápida (ideal para cadenas Fast)
VITE_GROQ_KEY=

# Google Gemini
VITE_GEMINI_KEY=

# NVIDIA NIM
VITE_NVIDIA_KEY=

# Mistral
VITE_MISTRAL_KEY=

# ─── APIs de Datos Mexicanos ───
# Token del DENUE (Directorio Estadístico Nacional de Unidades Económicas)
VITE_DENUE_KEY=

# Token del INEGI (Instituto Nacional de Estadística)
VITE_INEGI_KEY=

# ─── Configuración de Ollama (solo si se usa túnel local) ───
# OLLAMA_TUNNEL_URL=https://tu-tunel-ngrok.ngrok.io
